<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets scripts/android-smoke.sh add a download without UI. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity-alias
            android:name=".DebugAdd"
            android:targetActivity=".GotiActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.raptordnj.goti.debug.ADD" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="http" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
